#!/usr/bin/env bash
# usage: pi-box [--outdated] [pi args...]
set -euo pipefail

ctx=$(dirname "$(readlink -f "$0")")/../docker/pi-box
set -a
# shellcheck source=/dev/null
. "$ctx/versions.env"
set +a

if [[ ${1:-} == --outdated ]]; then
  echo "pi: $PI_VERSION -> $(npm view @earendil-works/pi-coding-agent version)"
  for e in $PI_EXTENSIONS; do
    n=${e#npm:}
    n=${n%@*}
    echo "$n: ${e##*@} -> $(npm view "$n" version)"
  done
  exit
fi

docker build -q -t pi-sandbox \
  --build-arg NODE_IMAGE --build-arg PI_VERSION --build-arg PI_EXTENSIONS \
  "$ctx" >/dev/null

tty=-i
[[ -t 0 ]] && tty=-it

state=$HOME/.pi/box
mkdir -p "$state/sessions" "$state/permission-mode"

exec docker run --rm --init "$tty" \
  --cpus 2 \
  --cap-drop ALL \
  --security-opt no-new-privileges \
  --pids-limit 512 \
  --memory 4g \
  -v "$PWD:/workspace" \
  -v "$HOME/.pi/agent/auth.json:/home/node/.pi/agent/auth.json:ro" \
  -v "$state/sessions:/home/node/.pi/agent/sessions" \
  -v "$state/permission-mode:/home/node/.pi/agent/permission-mode" \
  pi-sandbox "$@"
