{
  "extraKnownMarketplaces": {
    "claude-hooks": {
      "source": {
        "source": "github",
        "repo": "steeef/claude-hooks"
      }
    }
  },
  "outputStyle": "Brief",
  "includeCoAuthoredBy": false,
  "includeGitInstructions": false,
  "spinnerTipsEnabled": false,
  "autoMemoryEnabled": false,
  "companyAnnouncements": [],
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh",
    "padding": 0
  },
  "permissions": {
    "allow": [
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(prek run:*)",
      "Bash(rg:*)",
      "Bash(yamllint:*)",
      "Bash(yq:*)",
      "mcp__codegraph"
    ],
    "deny": [
      "Bash(pre-commit:*)",
      "DesignSync",
      "EnterPlanMode",
      "ExitPlanMode",
      "NotebookEdit",
      "PushNotification",
      "RemoteTrigger"
    ]
  },
  "env": {
    "BASH_MAX_OUTPUT_LENGTH": "150000"
  },
  "autoCompactWindow": 533000,
  "skillListingBudgetFraction": 0.02,
  "disableWorkflows": true,
  "disableRemoteControl": true,
  "disableClaudeAiConnectors": true,
  "disableArtifact": true,
  "disableBundledSkills": true,
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "~/.bin/format.sh"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/compact-instructions.sh",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
